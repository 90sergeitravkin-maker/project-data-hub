LOG_LEVEL=DEBUG
# БАЗЫ ДАННЫХ (PostgreSQL 15)
DB_LOCAL_01=postgresql://postgres:pass@localhost:5432/dbname
APP_SYSTEMS_DB=postgresql://postgres:pass@localhost:5432/dbname
APP_SERVICES_DB=postgresql://postgres:pass@localhost:5432/dbname
# APP FILE MANAGER (Системы / Файлы)
APP_FAIL_MANAGER_EXT=/opt/external_data
APP_FAIL_MANAGER_RAW=/opt/external_data_raw
APP_FAIL_MANAGER_TEMP=/opt/external_data_raw
APP_SYSTEMS_HOST=0.0.0.0
APP_SYSTEMS_PORT=8082
APP_SYSTEMS_RELOAD=false
APP_SYSTEMS_LOG_LEVEL=INFO
APP_SYSTEMS_TOKEN=********************************************,********************************************
# Токен для вызова check-сервиса (берётся первый из APP_SYSTEMS_TOKEN)
CHECK_SERVICE_TOKEN=dev_token_123456
# Куда Registry отправляет запросы на проверку
CHECK_DATA_ENDPOINT=http://127.0.0.1:8002/api/v1/systems/check-data
CHECK_DATA_TIMEOUT=30
# Подряд по парсингу
# app_auth
DB_LOCAL_AUTH=postgresql://postgres:pass@localhost:5432/dbname
# app_data_registry
APP_DATA_REGISTRY_DB=postgresql://postgres:pass@localhost:5432/dbname
APP_REGISTRY_HOST=0.0.0.0
APP_REGISTRY_PORT=8082
APP_REGISTRY_RELOAD=false
APP_REGISTRY_LOG_LEVEL=DEBUG
# app_ecomru
APP_ECOMRU_DB=postgresql://postgres:pass@localhost:5432/dbname
EXTERNAL_API_URL=https://appche3.ecomru.ru:4448
EXTERNAL_API_KEY=********************************************
# app_mail
APP_MAIL_FROM_EMAIL=*******************
APP_MAIL_SMTP_HOST=********************
APP_MAIL_SMTP_PORT=25
APP_MAIL_LOG_LEVEL=DEBUG
APP_MAIL_DB_ALIAS=app_mail
APP_MAIL_DB=postgresql://postgres:pass@localhost:5432/dbname
# app_text_dup_check
APP_TEXT_DUPE_CHECK_DB=postgresql://postgres:pass@localhost:5432/dbname
# app_datasets
WEB_DATASET_LOG_LEVEL=INFO
APP_DATASET_DB_ALIAS = app_datasets
APP_DATASET_DB=postgresql://postgres:pass@localhost:5432/dbname
# === app_monitor ===
APP_MONITOR_DB_ALIAS=app_monitor
MONITOR_RAM_WARNING_MB=512
MONITOR_RAM_CRITICAL_MB=1024
MONITOR_SNAPSHOT_INTERVAL=60
MONITOR_HISTORY_DAYS=7
MONITOR_TOP_N=10
MONITOR_TRACEMALLOC=false